# Looped Backend Environment Variables Example
# Duplicate this file to .env and provide your secret values.

# Server & Database
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=

# ML Service URL
ML_SERVICE_URL=

# OpenAI API (for visual search embeddings, chat assistant, quality analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (for checkout, escrow & seller payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Notifications & Messaging
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
